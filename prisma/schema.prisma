generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════
// PILLAR 1: DATA - Dynamic data sources (Google Sheets-like)
// ═══════════════════════════════════════════════════════════════

model DataSource {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  icon          String    @default("Table")
  color         String    @default("#C9A84C")
  sourceType    String    @default("manual") // manual, csv, googlesheet
  sourceUrl     String?   // URL for Google Sheet
  sheetId       String?   // Google Sheet ID
  sheetName     String?   // Specific sheet/tab name
  syncInterval  Int       @default(0) // minutes (0 = manual only)
  lastSyncedAt  DateTime?
  googleSessionId String? // Reference to the Google session used
  columns       Column[]
  rows          Row[]
  relations     Relation[] @relation("SourceRelation")
  targetRelations Relation[] @relation("TargetRelation")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("data_sources")
}

model Column {
  id           String     @id @default(cuid())
  name         String
  slug         String
  type         String     @default("TEXT") // TEXT, NUMBER, CURRENCY, IMAGE, IMAGE_ARRAY, SELECT, MULTI_SELECT, RELATION, ARRAY, BOOLEAN, URL
  dataSourceId String     @map("data_source_id")
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  visible      Boolean    @default(true)
  required     Boolean    @default(false)
  config       Json       @default("{}") // JSON: options for SELECT, sourceColumns for ARRAY, targetTable for RELATION, etc.
  width        Int        @default(150)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([dataSourceId, slug])
  @@map("columns")
}

model Row {
  id           String     @id @default(cuid())
  dataSourceId String     @map("data_source_id")
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  data         Json       @default("{}") // JSON: { columnSlug: value, ... }
  order        Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("rows")
}

model Relation {
  id             String     @id @default(cuid())
  name           String
  sourceTableId  String     @map("source_table_id")
  sourceTable    DataSource @relation("SourceRelation", fields: [sourceTableId], references: [id], onDelete: Cascade)
  sourceColumnId String     @map("source_column_id") // Column in source table that holds the reference
  targetTableId  String     @map("target_table_id")
  targetTable    DataSource @relation("TargetRelation", fields: [targetTableId], references: [id], onDelete: Cascade)
  type           String     @default("manyToOne") // manyToOne, oneToMany, manyToMany
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("relations")
}

// ═══════════════════════════════════════════════════════════════
// PILLAR 2: LAYOUT - Visual catalog configuration
// ═══════════════════════════════════════════════════════════════

model Catalog {
  id           String   @id @default(cuid())
  name         String   @default("Mon Catalogue")
  slug         String   @default("mon-catalogue") @unique
  published    Boolean  @default(false)
  sections     Section[]
  settings     CatalogSettings?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("catalogs")
}

model Section {
  id           String   @id @default(cuid())
  catalogId    String   @map("catalog_id")
  catalog      Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  type         String   @default("collection") // collection, hero, featured, text
  title        String?
  subtitle     String?
  config       Json     @default("{}") // JSON: layout-specific config
  order        Int      @default(0)
  visible      Boolean  @default(true)
  components   Component[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sections")
}

model Component {
  id          String   @id @default(cuid())
  sectionId   String   @map("section_id")
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type        String   @default("card") // card, carousel, grid, detail, button, text, image
  config      Json     @default("{}") // JSON: column mappings, styles, etc.
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("components")
}

// ═══════════════════════════════════════════════════════════════
// PILLAR 3: SETTINGS
// ═══════════════════════════════════════════════════════════════

model CatalogSettings {
  id                String   @id @default(cuid())
  catalogId         String   @unique @map("catalog_id")
  catalog           Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  language          String   @default("fr") // fr, en, ar
  currency          String   @default("MAD") // MAD, EUR, USD
  whatsappNumber    String   @default("") @map("whatsapp_number")
  messengerLink     String   @default("") @map("messenger_link")
  emailContact      String   @default("") @map("email_contact")
  instagramHandle   String   @default("") @map("instagram_handle")
  primaryColor      String   @default("#C9A84C") @map("primary_color")
  secondaryColor    String   @default("#1A1A1A") @map("secondary_color")
  accentColor       String   @default("#F5F0E8") @map("accent_color")
  backgroundColor   String   @default("#FAF8F5") @map("background_color")
  fontFamily        String   @default("inter") @map("font_family") // inter, playfair, roboto
  enableZoom        Boolean  @default(true) @map("enable_zoom")
  enableSearch      Boolean  @default(true) @map("enable_search")
  enableSharing     Boolean  @default(true) @map("enable_sharing")
  conversionChannel String   @default("whatsapp") @map("conversion_channel") // whatsapp, messenger, landing, email
  conversionMessage String   @default("") @map("conversion_message")
  customCSS         String   @default("") @map("custom_css")
  favicon           String?
  logo              String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("catalog_settings")
}

// ═══════════════════════════════════════════════════════════════
// GOOGLE INTEGRATION
// ═══════════════════════════════════════════════════════════════

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("admin_sessions")
}

model GoogleSession {
  id            String   @id @default(cuid())
  accessToken   String   @map("access_token")
  refreshToken  String?  @map("refresh_token")
  tokenExpiry   DateTime @map("token_expiry")
  scope         String   @default("")
  email         String?
  name          String?
  picture       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("google_sessions")
}

model Settings {
  key   String @id
  value String @default("")

  @@map("settings")
}
