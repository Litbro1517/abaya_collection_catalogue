generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// PILLAR 1: DATA - Dynamic data sources (Google Sheets-like)
// ═══════════════════════════════════════════════════════════════

model DataSource {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  icon            String     @default("Table")
  color           String     @default("#C9A84C")
  sourceType      String     @default("manual") // manual, csv, googlesheet
  sourceUrl       String?
  sheetId         String?
  sheetName       String?
  syncInterval    Int        @default(0)
  lastSyncedAt    DateTime?
  googleSessionId String?
  columns         Column[]
  rows            Row[]
  relations       Relation[] @relation("SourceRelation")
  targetRelations Relation[] @relation("TargetRelation")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("data_sources")
}

model Column {
  id           String     @id @default(cuid())
  name         String
  slug         String
  type         String     @default("TEXT")
  dataSourceId String     @map("data_source_id")
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  visible      Boolean    @default(true)
  required     Boolean    @default(false)
  config       Json?
  width        Int        @default(150)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([dataSourceId, slug])
  @@map("columns")
}

model Row {
  id           String       @id @default(cuid())
  dataSourceId String       @map("data_source_id")
  dataSource   DataSource   @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  data         Json?
  order        Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  mediaAssets  MediaAsset[]

  @@map("rows")
}

model Relation {
  id             String     @id @default(cuid())
  name           String
  sourceTableId  String     @map("source_table_id")
  sourceTable    DataSource @relation("SourceRelation", fields: [sourceTableId], references: [id], onDelete: Cascade)
  sourceColumnId String     @map("source_column_id")
  targetTableId  String     @map("target_table_id")
  targetTable    DataSource @relation("TargetRelation", fields: [targetTableId], references: [id], onDelete: Cascade)
  type           String     @default("manyToOne")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@map("relations")
}

// ═══════════════════════════════════════════════════════════════
// PILLAR 2: LAYOUT - Visual catalog configuration
// ═══════════════════════════════════════════════════════════════

model Catalog {
  id        String           @id @default(cuid())
  name      String           @default("Mon Catalogue")
  slug      String           @unique @default("mon-catalogue")
  published Boolean          @default(false)
  sections  Section[]
  settings  CatalogSettings?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("catalogs")
}

model Section {
  id         String      @id @default(cuid())
  catalogId  String      @map("catalog_id")
  catalog    Catalog     @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  type       String      @default("collection")
  title      String?
  subtitle   String?
  config     Json?
  order      Int         @default(0)
  visible    Boolean     @default(true)
  components Component[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("sections")
}

model Component {
  id        String   @id @default(cuid())
  sectionId String   @map("section_id")
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type      String   @default("card")
  config    Json?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("components")
}

// ═══════════════════════════════════════════════════════════════
// PILLAR 3: SETTINGS
// ═══════════════════════════════════════════════════════════════

model CatalogSettings {
  id                String   @id @default(cuid())
  catalogId         String   @unique @map("catalog_id")
  catalog           Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  language          String   @default("fr")
  currency          String   @default("MAD")
  whatsappNumber    String   @default("") @map("whatsapp_number")
  messengerLink     String   @default("") @map("messenger_link")
  emailContact      String   @default("") @map("email_contact")
  instagramHandle   String   @default("") @map("instagram_handle")
  facebookPage      String   @default("") @map("facebook_page")
  tiktokHandle      String   @default("") @map("tiktok_handle")
  primaryColor      String   @default("#C9A84C") @map("primary_color")
  secondaryColor    String   @default("#1A1A1A") @map("secondary_color")
  accentColor       String   @default("#F5F0E8") @map("accent_color")
  backgroundColor   String   @default("#FAF8F5") @map("background_color")
  fontFamily        String   @default("inter") @map("font_family")
  enableZoom        Boolean  @default(true) @map("enable_zoom")
  enableSearch      Boolean  @default(true) @map("enable_search")
  enableSharing     Boolean  @default(true) @map("enable_sharing")
  conversionChannel String   @default("whatsapp") @map("conversion_channel")
  conversionMessage String   @default("") @map("conversion_message")
  conversionMessages Json?   @map("conversion_messages")  // { fr: "...", en: "...", ar: "..." } — multilingual admin messages
  defaultCatalogLanguage String @default("fr") @map("default_catalog_language")  // initial language for new visitors
  brandGreenColor   String   @default("#1A3C34") @map("brand_green_color")
  destructiveColor  String   @default("#800020") @map("destructive_color")
  borderColor       String   @default("#E8E2D9") @map("border_color")
  customCSS         String   @default("") @map("custom_css")
  clientOverrides   Json?    @map("client_overrides")
  trustGuarantees   Json?    @map("trust_guarantees")
  savTexts          Json?    @map("sav_texts")  // VG36.3 Chantier 3: { delivery: { fr:{title,desc}, en:..., ar:... }, aftersales: {...} }
  favicon           String?
  logo              String?
  logoHeight        Int?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("catalog_settings")
}

// ═══════════════════════════════════════════════════════════════
// AUTHENTICATION & ADMIN USERS
// ═══════════════════════════════════════════════════════════════

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  picture      String?
  role         String         @default("admin") // owner, admin, editor
  status       String         @default("active") // active, suspended
  passwordHash String?        @map("password_hash")
  googleSub    String?        @map("google_sub") // Google OAuth subject ID
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  adminId   String    @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ip        String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")

  @@map("admin_sessions")
}

model AuditLog {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String // create, update, delete, login, logout, sync
  entity    String // datasource, section, catalog, settings, etc.
  entityId  String?   @map("entity_id")
  details   Json?
  ip        String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════
// GOOGLE INTEGRATION (Drive & Sheets API tokens)
// ═══════════════════════════════════════════════════════════════

model GoogleSession {
  id           String   @id @default(cuid())
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  tokenExpiry  DateTime @map("token_expiry")
  scope        String   @default("")
  email        String?
  name         String?
  picture      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("google_sessions")
}

model Settings {
  key   String @id
  value String @default("")

  @@map("settings")
}

// ═══════════════════════════════════════════════════════════════
// CATEGORIES - Dynamic two-level filtering system
// ━━━ Slug-first architecture: slug is immutable, label is renameable
// ━━━ Zero-product deletion constraint: cannot delete if products reference it
// ═══════════════════════════════════════════════════════════════

model Category {
  id             String         @id @default(cuid())
  slug           String         @unique          // Immutable identifier — NEVER changes after creation
  label          String                            // Display name — renameable by admin
  translations   Json?                             // { "fr": "Ensemble", "ar": "طقم", "en": "Set" }
  visible        Boolean        @default(true)   // Admin toggle: invisible = hidden from public catalog
  ordre          Int            @default(0)      // Display order (ascending)
  subCategories  SubCategory[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@map("categories")
}

model SubCategory {
  id           String   @id @default(cuid())
  slug         String   @unique          // Immutable identifier — NEVER changes after creation
  label        String                      // Display name — renameable by admin
  translations Json?                       // { "fr": "Nouveau", "ar": "جديد", "en": "New" }
  categoryId   String   @map("category_id")
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  visible      Boolean  @default(true)   // Admin toggle: invisible = hidden from public catalog
  ordre        Int      @default(0)      // Display order (ascending)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sub_categories")
}

// ═══════════════════════════════════════════════════════════════
// COLOR MAP - Centralized color library (Slow Luxury Architecture)
// ━━━ Normalized color names → hex codes, shared across all products
// ━━━ Triple-Flux: Admin Settings, DataTable Select, Mass Import
// ═══════════════════════════════════════════════════════════════

model ColorMap {
  id       String  @id @default(cuid())
  name     String  @unique              // Normalized Title Case (e.g. "Bleu-Nuit")
  slug     String  @unique              // Immutable identifier for matching
  hex      String                       // Hex code (e.g. "#1565C0")
  ordre    Int     @default(0)          // Display order (ascending)
  visible  Boolean @default(true)       // Admin toggle for visibility
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("color_map")
}

// ═══════════════════════════════════════════════════════════════
// ORDERS - Cash on Delivery (COD) order tunnel
// ═══════════════════════════════════════════════════════════════

model Order {
  id              String   @id @default(cuid())
  productId       String   @map("product_id")
  customerName    String   @map("customer_name")
  customerPhone   String   @map("customer_phone")
  customerCity    String   @map("customer_city")
  customerAddress String   @map("customer_address")
  status          String   @default("pending")
  productName     String?  @map("product_name")
  productPrice    String?  @map("product_price")
  // ━━ Structured variant data (Étape 3 — Merci page recap) ━━
  productColor    String?  @map("product_color")
  productSize     String?  @map("product_size")
  productQuantity Int      @default(1) @map("product_quantity")
  productImage    String?  @map("product_image")
  // ━━ Soft delete (Lean archivage — V4.1) ━━
  isDeleted       Boolean  @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  // ━━ Shadow table for cell-level edit history (V4.1) ━━
  history         OrderHistory[]
  // ━━ VG34: Multi-item cart support ━━
  items           OrderItem[]

  @@map("orders")
}

// ━━ OrderItem — Multi-product cart items (VG34) ━━
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  @map("product_id")
  productTitle String @map("product_title")
  productPrice String @map("product_price")
  productColor String? @map("product_color")
  productSize  String? @map("product_size")
  productQuantity Int @default(1) @map("product_quantity")
  productImage String? @map("product_image")

  @@index([orderId])
  @@map("order_items")
}

// ━━ OrderHistory — Shadow table for cell-level modification tracking ━━
// Each entry = one field change (old → new). Used for diff display + restore.
model OrderHistory {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field       String                    // 'customerName', 'customerPhone', 'status', etc.
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  changedBy   String   @map("changed_by")  // adminId
  changedAt   DateTime @default(now()) @map("changed_at")

  @@index([orderId, changedAt])
  @@map("order_history")
}

// ═══════════════════════════════════════════════════════════════
// MEDIA ASSETS — CDN-migrated images with uniqueness control (VG33)
// ═══════════════════════════════════════════════════════════════

model MediaAsset {
  id            String   @id @default(cuid())
  fileId        String   @map("file_id")    // Google Drive file_id (unique fingerprint)
  rowId         String?  @map("row_id")     // VG33.2: optional (null = orphan/unlinked)
  row           Row?     @relation(fields: [rowId], references: [id], onDelete: SetNull)
  originalRowId String?  @map("original_row_id") // VG33.2: memory of the original product for Relink
  dataSourceId  String   @map("data_source_id")
  columnSlug    String   @map("column_slug") // which IMAGE/IMAGE_ARRAY column
  originalUrl   String   @map("original_url") // original Drive URL
  cdnUrl        String?  @map("cdn_url")      // Supabase/local CDN URL after migration
  fileName      String?  @map("file_name")
  mimeType      String?  @map("mime_type")
  sizeBytes     Int?     @map("size_bytes")
  status        String   @default("drive")    // 'drive' | 'migrating' | 'cdn' | 'orphan' | 'failed'
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([fileId, columnSlug]) // uniqueness: one file_id per column (prevents cross-product duplicates)
  @@index([rowId])
  @@index([dataSourceId])
  @@index([fileId])
  @@map("media_assets")
}

// ── VG38: Landing Pages Module (Canva + IA Code) ──
model LandingPage {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  type            String   // "IMAGE_CANVA" | "CODE_IA"
  productId       String   // Row.id du produit associé

  // Champs spécifiques au Mode Image (Canva)
  desktopImageUrl String?
  mobileImageUrl  String?

  // Configuration des 3 Boutons CTA (Mode Image)
  showCtaTop      Boolean  @default(true)
  ctaTopText      String?  @default("Commander Maintenant")
  showCtaMiddle   Boolean  @default(true)
  ctaMiddleText   String?  @default("Profiter de l'Offre")
  showCtaBottom   Boolean  @default(true)
  ctaBottomText   String?  @default("Valider ma Commande")

  // Champs spécifiques au Mode Code IA
  htmlContent     String?

  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("landing_pages")
}
